# ─── Auto-detect text files, normalize to LF ─────────────────────────────────
* text=auto

# ─── Shell scripts (must be LF in containers) ────────────────────────────────
*.sh      text eol=lf

# ─── Java / Maven ────────────────────────────────────────────────────────────
*.java          text eol=lf diff=java
*.xml           text eol=lf
*.properties    text eol=lf
*.gradle        text eol=lf
*.kt            text eol=lf

# ─── JVM binary artifacts ────────────────────────────────────────────────────
*.jar           binary
*.class         binary
*.war           binary
*.ear           binary

# ─── TypeScript / React frontend ─────────────────────────────────────────────
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.css           text eol=lf
*.scss          text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.vue           text eol=lf

# ─── Config / Data ───────────────────────────────────────────────────────────
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.env           text eol=lf
*.csv           text eol=lf
*.tsv           text eol=lf

# ─── Documentation ───────────────────────────────────────────────────────────
*.md            text eol=lf
*.rst           text eol=lf
*.txt           text eol=lf

# ─── Images / Binary ─────────────────────────────────────────────────────────
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.svg           text eol=lf
*.ico           binary
*.pdf           binary
*.parquet       binary
*.feather       binary

# ─── Archives / Data ─────────────────────────────────────────────────────────
*.zip           binary
*.tar           binary
*.gz            binary
*.bz2           binary
*.7z            binary
*.h5            binary
*.hdf5          binary

# ─── Lock files (generated) — collapse diffs on GitHub ───────────────────────
package-lock.json  linguist-generated=true -diff
*.lock             linguist-generated=true -diff

# ─── GitHub Linguist — mark docs / config as non-vendored ────────────────────
docs/**          linguist-documentation=false
scripts/**       linguist-documentation=false
